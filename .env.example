# PostgreSQL (matches docker-compose service)
PGHOST=localhost
PGPORT=5432
PGDATABASE=stayhub
PGUSER=stayhub_app
PGPASSWORD=stayhub_app_pass

# Used only by migrate runner (owner role)
OWNER_PGUSER=stayhub_owner
OWNER_PGPASSWORD=stayhub_owner_pass

# API
PORT=3000
NODE_ENV=development

# Worker
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=4

# Mock OTA
MOCK_OTA_PORT=4000
# URL the mock OTA calls back to us on
API_BASE_URL=http://api:3000
